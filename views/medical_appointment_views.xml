<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_medical_appointment_tree" model="ir.ui.view">
        <field name="name">medical.appointment.tree</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <list string="Turnos" decoration-info="state=='draft'" 
                  decoration-success="state=='attended'" 
                  decoration-danger="state=='cancelled'"
                  decoration-warning="state=='absent'">
                <field name="display_name"/>
                <field name="specialty_id"/>
                <field name="practice_id"/>
                <field name="doctor_id"/>
                <field name="patient_name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'" 
                       decoration-primary="state=='confirmed'"
                       decoration-success="state=='attended'"
                       decoration-danger="state=='cancelled'"
                       decoration-warning="state=='absent'"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_medical_appointment_kanban" model="ir.ui.view">
        <field name="name">medical.appointment.kanban</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="specialty_id"/>
                <field name="doctor_id"/>
                <field name="patient_name"/>
                <field name="date_start"/>
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="patient_name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="specialty_id"/> - <field name="doctor_id"/>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <i class="fa fa-clock-o"/> <field name="date_start"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Calendar -->
    <record id="view_medical_appointment_calendar" model="ir.ui.view">
        <field name="name">medical.appointment.calendar</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Turnos" 
                      date_start="date_start" 
                      date_stop="date_end" 
                      color="doctor_id"
                      mode="week"
                      quick_create="0"
                      event_open_popup="1">
                <field name="patient_name"/>
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="state" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_medical_appointment_form" model="ir.ui.view">
        <field name="name">medical.appointment.form</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <form string="Turno Médico">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_attend" string="Atender" type="object" 
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_mark_absent" string="Marcar Ausente" type="object" 
                            invisible="state != 'confirmed'"/>
                    <button name="action_reschedule" string="Reprogramar" type="object" 
                            invisible="state in ['attended', 'cancelled']"/>
                    <button name="action_cancel" string="Cancelar" type="object" 
                            invisible="state in ['attended', 'cancelled']"/>
                    <button name="action_view_clinical_history" string="Ver Historia Clínica" type="object" 
                            class="oe_highlight" invisible="not has_clinical_history"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,attended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>💡 Dos formas de agendar:</strong><br/>
                        <strong>Flujo 1:</strong> Busque el médico → Seleccione especialidad/práctica → Elija horario<br/>
                        <strong>Flujo 2:</strong> Seleccione especialidad → Práctica → Médico → Elija horario
                    </div>
                    
                    <group>
                        <group string="🩺 FLUJO 1: ¿Conoce al médico?">
                            <field name="doctor_id" 
                                   placeholder="Buscar médico por nombre..." 
                                   options="{'no_create': True}"
                                   help="Si conoce al médico, búsquelo aquí primero"/>
                        </group>
                        <group string="🏥 FLUJO 2: O seleccione especialidad">
                            <field name="specialty_id" 
                                   options="{'no_create': True}"
                                   help="Seleccione la especialidad médica"/>
                        </group>
                    </group>
                    
                    <group invisible="not doctor_id and not specialty_id">
                        <group string="Especialidad/Profesión">
                            <field name="specialty_id" 
                                   invisible="not doctor_id"
                                   required="doctor_id and True or False"
                                   options="{'no_create': True}"
                                   help="Seleccione con qué especialidad desea atenderse"/>
                            <field name="practice_id" 
                                   domain="[('specialty_id', '=', specialty_id)]"
                                   required="specialty_id and True or False"
                                   help="Tipo de atención o práctica"/>
                        </group>
                        <group string="Médico">
                            <field name="doctor_id" 
                                   invisible="doctor_id"
                                   required="specialty_id and practice_id and True or False"
                                   options="{'no_create': True}"
                                   help="Médicos que atienden esta especialidad"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    
                    <separator string="📅 Selección de Fecha y Hora" invisible="not doctor_id or not specialty_id or not practice_id"/>
                    
                    <group invisible="not doctor_id or not specialty_id or not practice_id">
                        <group colspan="2">
                            <div class="alert alert-info">
                                <strong>ℹ️ Calendario de Disponibilidad</strong><br/>
                                • Los días <span style="color: #28a745; font-weight: bold;">VERDES</span> tienen horarios disponibles<br/>
                                • Los días <span style="color: #6c757d;">GRISES</span> no tienen disponibilidad<br/>
                                • Haga clic en un día verde para ver los horarios<br/>
                                • Haga clic en un horario para seleccionarlo
                            </div>
                        </group>
                    </group>
                    
                    <group invisible="not doctor_id or not specialty_id or not practice_id">
                        <group colspan="2">
                            <field name="available_slots_html" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    
                    <group invisible="not doctor_id or not specialty_id or not practice_id">
                        <group string="Horario Seleccionado">
                            <field name="date_start" 
                                   required="doctor_id and specialty_id and practice_id and True or False"
                                   widget="datetime"
                                   help="Seleccione desde el calendario arriba o ingrese manualmente"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group></group>
                    </group>
                    
                    <separator string="👤 Datos del Paciente" invisible="not date_start"/>
                    
                    <group string="Paciente" invisible="not date_start">
                        <field name="patient_type" widget="radio" invisible="1"/>
                        <field name="patient_id" invisible="patient_type != 'person'" 
                               domain="[('is_company', '=', False)]" 
                               context="{'default_is_patient': True}"/>
                        <field name="patient_animal_id" invisible="patient_type != 'animal'"/>
                    </group>
                    <group string="Motivo de Consulta">
                        <field name="reason" nolabel="1" placeholder="Describa el motivo de la consulta..."/>
                    </group>
                    <notebook>
                        <page string="Información Adicional" name="additional_info">
                            <group>
                                <field name="notes" placeholder="Notas adicionales..."/>
                            </group>
                        </page>
                        <page string="Auditoría" name="audit">
                            <group>
                                <group string="Confirmación">
                                    <field name="confirmed_date" readonly="1"/>
                                    <field name="confirmed_by" readonly="1"/>
                                </group>
                                <group string="Atención">
                                    <field name="attended_date" readonly="1"/>
                                    <field name="has_clinical_history" readonly="1"/>
                                    <field name="clinical_history_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Cancelación">
                                    <field name="cancelled_date" readonly="1"/>
                                    <field name="cancelled_by" readonly="1"/>
                                    <field name="cancellation_reason" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_medical_appointment_search" model="ir.ui.view">
        <field name="name">medical.appointment.search</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <search string="Buscar Turnos">
                <field name="patient_name"/>
                <field name="specialty_id"/>
                <field name="doctor_id"/>
                <field name="practice_id"/>
                <field name="patient_id"/>
                <field name="patient_animal_id"/>
                <separator/>
                <filter string="Borradores" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmados" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Atendidos" name="filter_attended" domain="[('state', '=', 'attended')]"/>
                <filter string="Cancelados" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Ausentes" name="filter_absent" domain="[('state', '=', 'absent')]"/>
                <separator/>
                <filter string="Hoy" name="filter_today" 
                        domain="[('date_start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('date_start', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Esta Semana" name="filter_week" 
                        domain="[('date_start', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                 ('date_start', '&lt;', (context_today() + datetime.timedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Este Mes" name="filter_month" 
                        domain="[('date_start', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Pacientes Personas" name="filter_person" domain="[('patient_type', '=', 'person')]"/>
                <filter string="Pacientes Animales" name="filter_animal" domain="[('patient_type', '=', 'animal')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Médico" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Especialidad" name="group_specialty" context="{'group_by': 'specialty_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date_start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_medical_appointment" model="ir.actions.act_window">
        <field name="name">Turnos Médicos</field>
        <field name="res_model">medical.appointment</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo turno médico
            </p>
            <p>
                Comience seleccionando una especialidad médica.
                Luego elija el tipo de atención, el médico y el paciente.
            </p>
        </field>
    </record>

</odoo>
