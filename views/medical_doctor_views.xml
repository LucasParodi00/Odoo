<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_medical_doctor_tree" model="ir.ui.view">
        <field name="name">medical.doctor.tree</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <list string="Médicos">
                <field name="partner_id"/>
                <field name="license_number"/>
                <field name="specialty_ids" widget="many2many_tags"/>
                <field name="appointment_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_medical_doctor_kanban" model="ir.ui.view">
        <field name="name">medical.doctor.kanban</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="partner_id"/>
                <field name="license_number"/>
                <field name="specialty_ids"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb8">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="partner_id"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle" t-if="record.license_number.raw_value">
                                            Mat. <field name="license_number"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_tags_section">
                                    <field name="specialty_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_medical_doctor_form" model="ir.ui.view">
        <field name="name">medical.doctor.form</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <form string="Médico">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Turnos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_quick_create': True}" context="{'default_is_company': False}"/>
                            <field name="license_number"/>
                            <field name="specialty_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agendas" name="schedules">
                            <field name="specialty_ids" invisible="1"/>
                            <field name="schedule_ids" context="{'default_doctor_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="specialty_id"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="doctor_id" invisible="1"/>
                                                <field name="name"/>
                                                <field name="specialty_id" options="{'no_create': True}" domain="[('id', 'in', parent.specialty_ids)]"/>
                                                <field name="active"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Horarios de Trabajo" name="schedule_lines">
                                                <field name="schedule_line_ids">
                                                    <list editable="bottom">
                                                        <field name="day_of_week"/>
                                                        <field name="hour_from" widget="float_time"/>
                                                        <field name="hour_to" widget="float_time"/>
                                                        <field name="hour_from_display" string="Desde"/>
                                                        <field name="hour_to_display" string="Hasta"/>
                                                    </list>
                                                </field>
                                                <group>
                                                    <p class="text-muted">
                                                        Defina los días y rangos horarios en los que el médico atiende.
                                                        Puede agregar múltiples rangos por día.
                                                    </p>
                                                </group>
                                            </page>
                                            <page string="Bloqueos" name="blocks">
                                                <field name="block_ids">
                                                    <list>
                                                        <field name="name"/>
                                                        <field name="block_type"/>
                                                        <field name="date_from"/>
                                                        <field name="date_to"/>
                                                        <field name="all_day" widget="boolean_toggle"/>
                                                    </list>
                                                    <form>
                                                        <sheet>
                                                            <group>
                                                                <group>
                                                                    <field name="name"/>
                                                                    <field name="block_type"/>
                                                                    <field name="schedule_id" invisible="1"/>
                                                                </group>
                                                                <group>
                                                                    <field name="date_from"/>
                                                                    <field name="date_to"/>
                                                                    <field name="all_day"/>
                                                                    <field name="color" widget="color_picker"/>
                                                                </group>
                                                            </group>
                                                            <group string="Notas">
                                                                <field name="notes" nolabel="1" placeholder="Notas adicionales..."/>
                                                            </group>
                                                        </sheet>
                                                        <chatter/>
                                                    </form>
                                                </field>
                                                <group>
                                                    <p class="text-muted">
                                                        Los bloqueos impiden que se agenden turnos en esos períodos
                                                        (vacaciones, ausencias, capacitaciones, etc.).
                                                    </p>
                                                </group>
                                            </page>
                                            <page string="Fechas de Vigencia" name="dates">
                                                <group>
                                                    <field name="date_start"/>
                                                    <field name="date_end"/>
                                                </group>
                                                <group>
                                                    <p class="text-muted">
                                                        Las fechas de vigencia son opcionales. Si no se especifican,
                                                        la agenda estará activa indefinidamente.
                                                    </p>
                                                </group>
                                            </page>
                                            <page string="Notas" name="notes">
                                                <field name="notes" placeholder="Notas adicionales sobre esta agenda..."/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                    <chatter/>
                                </form>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas adicionales sobre el médico..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_medical_doctor_search" model="ir.ui.view">
        <field name="name">medical.doctor.search</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <search string="Buscar Médicos">
                <field name="name"/>
                <field name="license_number"/>
                <field name="specialty_ids"/>
                <field name="partner_id"/>
                <filter string="Activos" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archivados" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Especialidad" name="group_specialty" context="{'group_by': 'specialty_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_medical_doctor" model="ir.actions.act_window">
        <field name="name">Médicos</field>
        <field name="res_model">medical.doctor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar un nuevo médico
            </p>
            <p>
                Los médicos son profesionales que brindan atención.
                Cada médico debe tener al menos una especialidad
                y una agenda configurada.
            </p>
        </field>
    </record>

</odoo>
