<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_medical_specialty_tree" model="ir.ui.view">
        <field name="name">medical.specialty.tree</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <list string="Especialidades Médicas">
                <field name="name"/>
                <field name="code"/>
                <field name="patient_type"/>
                <field name="doctor_count"/>
                <field name="practice_count"/>
                <field name="appointment_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_medical_specialty_kanban" model="ir.ui.view">
        <field name="name">medical.specialty.kanban</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="patient_type"/>
                <field name="color"/>
                <field name="doctor_count"/>
                <field name="practice_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <span class="badge text-bg-primary" t-if="record.code.raw_value">
                                        <field name="code"/>
                                    </span>
                                    <span class="badge text-bg-info">
                                        <field name="patient_type"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><i class="fa fa-user-md"/> <field name="doctor_count"/> Médicos</span>
                                        <span class="ms-2"><i class="fa fa-stethoscope"/> <field name="practice_count"/> Prácticas</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_medical_specialty_form" model="ir.ui.view">
        <field name="name">medical.specialty.form</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <form string="Especialidad Médica">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_doctors" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-user-md">
                            <field name="doctor_count" widget="statinfo" string="Médicos"/>
                        </button>
                        <button name="action_view_practices" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-stethoscope">
                            <field name="practice_count" widget="statinfo" string="Prácticas"/>
                        </button>
                        <button name="action_view_appointments" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Turnos"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="ej. Clínica General, Cirugía, Veterinaria"/>
                            <field name="code"/>
                            <field name="patient_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" placeholder="Descripción detallada de la especialidad..."/>
                        </page>
                        <page string="Médicos" name="doctors">
                            <field name="doctor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="license_number"/>
                                    <field name="specialty_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prácticas" name="practices">
                            <field name="practice_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="duration"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="view_medical_specialty_search" model="ir.ui.view">
        <field name="name">medical.specialty.search</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <search string="Buscar Especialidades">
                <field name="name"/>
                <field name="code"/>
                <filter string="Personas" name="filter_person" domain="[('patient_type', 'in', ['person', 'both'])]"/>
                <filter string="Animales" name="filter_animal" domain="[('patient_type', 'in', ['animal', 'both'])]"/>
                <separator/>
                <filter string="Activas" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo de Paciente" name="group_patient_type" context="{'group_by': 'patient_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_medical_specialty" model="ir.actions.act_window">
        <field name="name">Especialidades Médicas</field>
        <field name="res_model">medical.specialty</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva especialidad médica
            </p>
            <p>
                Las especialidades son el punto de inicio del flujo de turnos.
                Pueden ser para personas, animales o ambos.
            </p>
        </field>
    </record>

</odoo>
