<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Especialidades para Clínicas Médicas (Personas) -->
        <record id="specialty_general_medicine" model="medical.specialty">
            <field name="name">Clínica General</field>
            <field name="code">CLG</field>
            <field name="patient_type">person</field>
            <field name="description">Atención médica general para adultos</field>
            <field name="color">1</field>
        </record>

        <record id="specialty_pediatrics" model="medical.specialty">
            <field name="name">Pediatría</field>
            <field name="code">PED</field>
            <field name="patient_type">person</field>
            <field name="description">Atención médica especializada para niños y adolescentes</field>
            <field name="color">3</field>
        </record>

        <record id="specialty_cardiology" model="medical.specialty">
            <field name="name">Cardiología</field>
            <field name="code">CAR</field>
            <field name="patient_type">person</field>
            <field name="description">Especialidad del corazón y sistema circulatorio</field>
            <field name="color">2</field>
        </record>

        <record id="specialty_dermatology" model="medical.specialty">
            <field name="name">Dermatología</field>
            <field name="code">DER</field>
            <field name="patient_type">person</field>
            <field name="description">Especialidad de la piel y anexos</field>
            <field name="color">4</field>
        </record>

        <record id="specialty_gynecology" model="medical.specialty">
            <field name="name">Ginecología</field>
            <field name="code">GIN</field>
            <field name="patient_type">person</field>
            <field name="description">Especialidad del aparato reproductor femenino</field>
            <field name="color">5</field>
        </record>

        <record id="specialty_traumatology" model="medical.specialty">
            <field name="name">Traumatología</field>
            <field name="code">TRA</field>
            <field name="patient_type">person</field>
            <field name="description">Especialidad del sistema musculoesquelético</field>
            <field name="color">6</field>
        </record>

        <record id="specialty_ophthalmology" model="medical.specialty">
            <field name="name">Oftalmología</field>
            <field name="code">OFT</field>
            <field name="patient_type">person</field>
            <field name="description">Especialidad de los ojos y la visión</field>
            <field name="color">7</field>
        </record>

        <record id="specialty_odontology" model="medical.specialty">
            <field name="name">Odontología</field>
            <field name="code">ODO</field>
            <field name="patient_type">person</field>
            <field name="description">Especialidad de dientes y cavidad oral</field>
            <field name="color">8</field>
        </record>

        <!-- Especialidades Veterinarias (Animales) -->
        <record id="specialty_vet_general" model="medical.specialty">
            <field name="name">Veterinaria General</field>
            <field name="code">VTG</field>
            <field name="patient_type">animal</field>
            <field name="description">Atención veterinaria general para mascotas</field>
            <field name="color">9</field>
        </record>

        <record id="specialty_vet_surgery" model="medical.specialty">
            <field name="name">Cirugía Veterinaria</field>
            <field name="code">VTS</field>
            <field name="patient_type">animal</field>
            <field name="description">Cirugías y procedimientos quirúrgicos en animales</field>
            <field name="color">10</field>
        </record>

        <record id="specialty_vet_exotic" model="medical.specialty">
            <field name="name">Animales Exóticos</field>
            <field name="code">VTE</field>
            <field name="patient_type">animal</field>
            <field name="description">Atención de aves, reptiles y animales exóticos</field>
            <field name="color">11</field>
        </record>

        <record id="specialty_vet_equine" model="medical.specialty">
            <field name="name">Medicina Equina</field>
            <field name="code">VTQ</field>
            <field name="patient_type">animal</field>
            <field name="description">Atención especializada en caballos</field>
            <field name="color">1</field>
        </record>

        <!-- Especialidad Mixta (ejemplo) -->
        <record id="specialty_pathology" model="medical.specialty">
            <field name="name">Patología</field>
            <field name="code">PAT</field>
            <field name="patient_type">both</field>
            <field name="description">Análisis de laboratorio y diagnóstico por imágenes</field>
            <field name="color">0</field>
        </record>

    </data>
</odoo>
