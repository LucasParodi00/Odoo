<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Form heredada de res.partner para agregar campos de médico -->
    <record id="view_partner_form_doctor" model="ir.ui.view">
        <field name="name">res.partner.form.doctor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Agregar el campo "Es Médico" después del campo company_type -->
            <field name="company_type" position="after">
                <field name="is_doctor" widget="boolean_toggle"/>
            </field>
            
            <!-- Agregar una pestaña con información del médico -->
            <xpath expr="//notebook" position="inside">
                <page string="Información Médica" invisible="not is_doctor">
                    <group>
                        <group string="Datos Profesionales">
                            <field name="doctor_license_number" required="is_doctor"/>
                            <field name="doctor_dni"/>
                        </group>
                    </group>
                    
                    <separator string="Especialidades"/>
                    <field name="doctor_specialty_line_ids">
                        <list string="Especialidades" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="specialty_id" required="1"/>
                            <field name="duration" required="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                    
                    <separator string="Agendas"/>
                    <field name="doctor_specialty_ids" invisible="1"/>
                    <field name="doctor_schedule_ids" 
                           context="{'default_doctor_id': id, 'doctor_specialty_ids': doctor_specialty_ids}">
                        <list string="Agendas">
                            <field name="name"/>
                            <field name="specialty_id" widget="badge"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                        <form>
                            <group>
                                <group>
                                    <field name="name" placeholder="ej: Agenda Mañana - Cirugía" required="1"/>
                                    <field name="doctor_id" invisible="1"/>
                                    <field name="specialty_id" 
                                           widget="selection"
                                           domain="[('id', 'in', parent.doctor_specialty_ids)]"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                </group>
                                <group>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                            </group>
                            
                            <notebook>
                                <page string="Horarios">
                                    <field name="schedule_line_ids">
                                        <list string="Horarios" editable="bottom">
                                            <field name="day_of_week" required="1"/>
                                            <field name="hour_from" widget="float_time" required="1"/>
                                            <field name="hour_to" widget="float_time" required="1"/>
                                            <field name="hour_from_display" readonly="1" optional="show"/>
                                            <field name="hour_to_display" readonly="1" optional="show"/>
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Vista List específica para médicos -->
    <record id="view_doctor_list" model="ir.ui.view">
        <field name="name">res.partner.doctor.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Médicos">
                <field name="name"/>
                <field name="doctor_license_number"/>
                <field name="doctor_dni"/>
                <field name="doctor_specialty_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista Form específica para médicos (hereda de la anterior) -->
    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">res.partner.doctor.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="view_partner_form_doctor"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- Ocultar el campo "Es Médico" en la vista específica de médicos -->
            <field name="is_doctor" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <!-- Vista Search para médicos -->
    <record id="view_doctor_search" model="ir.ui.view">
        <field name="name">res.partner.doctor.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar Médicos">
                <field name="name" string="Médico" 
                       filter_domain="['|', '|', ('name', 'ilike', self), ('doctor_license_number', 'ilike', self), ('doctor_dni', 'ilike', self)]"/>
                <field name="doctor_license_number"/>
                <field name="doctor_dni"/>
                <field name="doctor_specialty_ids"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('is_doctor', '=', True), ('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('is_doctor', '=', True), ('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Especialidad" name="group_specialty" 
                            context="{'group_by': 'doctor_specialty_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista Kanban para médicos -->
    <record id="view_doctor_kanban" model="ir.ui.view">
        <field name="name">res.partner.doctor.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban string="Médicos">
                <field name="id"/>
                <field name="name"/>
                <field name="doctor_license_number"/>
                <field name="doctor_specialty_ids"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        Mat. <field name="doctor_license_number"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="doctor_specialty_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <div t-if="record.phone.raw_value">
                                    <i class="fa fa-phone" title="Teléfono"/> <field name="phone"/>
                                </div>
                                <div t-if="record.email.raw_value">
                                    <i class="fa fa-envelope" title="Email"/> <field name="email"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción para médicos -->
    <record id="action_medical_doctor" model="ir.actions.act_window">
        <field name="name">Médicos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_doctor', '=', True)]</field>
        <field name="context">{
            'default_is_doctor': True,
            'search_default_active': 1,
        }</field>
        <field name="search_view_id" ref="view_doctor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo médico
            </p>
            <p>
                Los médicos son contactos especiales con información profesional adicional.
                Agregue su matrícula profesional, DNI/CUIL y especialidades.
            </p>
        </field>
    </record>

    <!-- Vincular vistas específicas a la acción -->
    <record id="action_medical_doctor_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_doctor_kanban"/>
        <field name="act_window_id" ref="action_medical_doctor"/>
    </record>

    <record id="action_medical_doctor_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_doctor_list"/>
        <field name="act_window_id" ref="action_medical_doctor"/>
    </record>

    <record id="action_medical_doctor_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_doctor_form"/>
        <field name="act_window_id" ref="action_medical_doctor"/>
    </record>

</odoo>
