<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List de Especialidades -->
    <record id="view_medical_specialty_tree" model="ir.ui.view">
        <field name="name">medical.specialty.tree</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <list string="Especialidades Médicas">
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista Form de Especialidades -->
    <record id="view_medical_specialty_form" model="ir.ui.view">
        <field name="name">medical.specialty.form</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <form string="Especialidad Médica">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="ej: Consulta Oftalmológica"/>
                            <field name="code" placeholder="ej: co"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search de Especialidades -->
    <record id="view_medical_specialty_search" model="ir.ui.view">
        <field name="name">medical.specialty.search</field>
        <field name="model">medical.specialty</field>
        <field name="arch" type="xml">
            <search string="Buscar Especialidades">
                <field name="name" string="Especialidad" 
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para Especialidades -->
    <record id="action_medical_specialty" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">medical.specialty</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva especialidad médica
            </p>
            <p>
                Las especialidades son las diferentes áreas de atención médica que ofrece el centro.
                Por ejemplo: Consulta General, Oftalmología, Cirugía, etc.
            </p>
        </field>
    </record>

</odoo>
