<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Calendar de Slots -->
    <record id="view_appointment_slot_calendar" model="ir.ui.view">
        <field name="name">appointment.slot.calendar</field>
        <field name="model">appointment.slot</field>
        <field name="arch" type="xml">
            <calendar string="Slots Disponibles" 
                      date_start="start_datetime" 
                      date_stop="end_datetime"
                      color="doctor_id"
                      mode="week"
                      event_open_popup="true"
                      quick_create="0"
                      create="0"
                      delete="0">
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="state"/>
                <field name="start_time_display"/>
                <field name="end_time_display"/>
            </calendar>
        </field>
    </record>

    <!-- Vista List de Slots -->
    <record id="view_appointment_slot_list" model="ir.ui.view">
        <field name="name">appointment.slot.list</field>
        <field name="model">appointment.slot</field>
        <field name="arch" type="xml">
            <list string="Slots" 
                  create="0" 
                  delete="0"
                  decoration-success="state == 'available'"
                  decoration-warning="state == 'reserved'"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="start_time_display"/>
                <field name="end_time_display"/>
                <field name="duration" widget="float_time"/>
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="state" 
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'reserved'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="appointment_id"/>
            </list>
        </field>
    </record>

    <!-- Vista Form de Slots -->
    <record id="view_appointment_slot_form" model="ir.ui.view">
        <field name="name">appointment.slot.form</field>
        <field name="model">appointment.slot</field>
        <field name="arch" type="xml">
            <form string="Slot" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,cancelled"/>
                    <button name="action_release" 
                            string="Liberar" 
                            type="object" 
                            invisible="state != 'reserved'"
                            class="btn-primary"
                            confirm="¿Está seguro de liberar este slot?"/>
                    <button name="action_cancel" 
                            string="Cancelar" 
                            type="object" 
                            invisible="state == 'cancelled'"
                            class="btn-danger"
                            confirm="¿Está seguro de cancelar este slot?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información del Slot">
                            <field name="doctor_id" readonly="1"/>
                            <field name="specialty_id" readonly="1"/>
                            <field name="doctor_specialty_line_id" invisible="1"/>
                            <field name="schedule_id" readonly="1"/>
                            <field name="appointment_id" readonly="1"/>
                        </group>
                        <group string="Fecha y Hora">
                            <field name="date" readonly="1"/>
                            <field name="start_time" widget="float_time" readonly="1"/>
                            <field name="end_time" widget="float_time" readonly="1"/>
                            <field name="start_time_display" readonly="1"/>
                            <field name="end_time_display" readonly="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="start_datetime" readonly="1"/>
                            <field name="end_datetime" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search de Slots -->
    <record id="view_appointment_slot_search" model="ir.ui.view">
        <field name="name">appointment.slot.search</field>
        <field name="model">appointment.slot</field>
        <field name="arch" type="xml">
            <search string="Buscar Slots">
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="date"/>
                <field name="state"/>
                
                <filter name="available" string="Disponibles" domain="[('state', '=', 'available')]"/>
                <filter name="reserved" string="Reservados" domain="[('state', '=', 'reserved')]"/>
                <filter name="cancelled" string="Cancelados" domain="[('state', '=', 'cancelled')]"/>
                
                <separator/>
                <filter name="today" string="Hoy" domain="[('date', '=', context_today())]"/>
                <filter name="this_week" string="Esta Semana" 
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weeks=-1, weekday=0)).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(weeks=-1, weekday=6)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="next_week" string="Próxima Semana"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weeks=0, weekday=0)).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%%Y-%%m-%%d'))]"/>
                
                <group expand="0" string="Agrupar Por">
                    <filter name="group_by_doctor" string="Médico" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_by_specialty" string="Especialidad" context="{'group_by': 'specialty_id'}"/>
                    <filter name="group_by_date" string="Fecha" context="{'group_by': 'date'}"/>
                    <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para Slots -->
    <record id="action_appointment_slot" model="ir.actions.act_window">
        <field name="name">Slots de Turnos</field>
        <field name="res_model">appointment.slot</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{
            'search_default_available': 1,
            'search_default_this_week': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Slots de Turnos
            </p>
            <p>
                Los slots se generan automáticamente basados en las agendas médicas.
                Puede ver los slots disponibles en el calendario.
            </p>
        </field>
    </record>

</odoo>
