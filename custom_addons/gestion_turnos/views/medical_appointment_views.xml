<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Calendar de Turnos -->
    <record id="view_medical_appointment_calendar" model="ir.ui.view">
        <field name="name">medical.appointment.calendar</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Turnos Médicos" 
                      date_start="appointment_datetime" 
                      date_stop="appointment_end_datetime"
                      color="doctor_id"
                      mode="week"
                      event_open_popup="true"
                      quick_create="0">
                <field name="patient_display"/>
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Vista Kanban de Turnos -->
    <record id="view_medical_appointment_kanban" model="ir.ui.view">
        <field name="name">medical.appointment.kanban</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="patient_display"/>
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="appointment_date"/>
                <field name="appointment_time_display"/>
                <field name="state"/>
                <field name="payment_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><strong><field name="name"/></strong></div>
                                    <div class="o_secondary"><field name="patient_display"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div>
                                    <i class="fa fa-user-md"/> <field name="doctor_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-stethoscope"/> <field name="specialty_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-calendar"/> <field name="appointment_date"/> 
                                    <i class="fa fa-clock-o"/> <field name="appointment_time_display"/>
                                </div>
                            </div>
                            <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                <a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                                <a role="menuitem" type="delete" class="dropdown-item">Eliminar</a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista List de Turnos -->
    <record id="view_medical_appointment_list" model="ir.ui.view">
        <field name="name">medical.appointment.list</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <list string="Turnos" 
                  decoration-info="state == 'scheduled'"
                  decoration-success="state == 'confirmed'"
                  decoration-warning="state == 'in_progress'"
                  decoration-muted="state in ('cancelled', 'no_show')">
                <field name="name"/>
                <field name="patient_display"/>
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="appointment_date"/>
                <field name="appointment_time_display"/>
                <field name="duration" widget="float_time"/>
                <field name="state" 
                       decoration-info="state == 'scheduled'"
                       decoration-success="state in ('confirmed', 'completed')"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state in ('cancelled', 'no_show')"/>
                <field name="payment_state"/>
            </list>
        </field>
    </record>

    <!-- Vista Form de Turnos -->
    <record id="view_medical_appointment_form" model="ir.ui.view">
        <field name="name">medical.appointment.form</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <form string="Turno Médico">
                <header>
                    <button name="action_confirm" 
                            string="Confirmar" 
                            type="object" 
                            invisible="state != 'scheduled'"
                            class="btn-primary"/>
                    <button name="action_start" 
                            string="Iniciar Consulta" 
                            type="object" 
                            invisible="state != 'confirmed'"
                            class="btn-primary"/>
                    <button name="action_complete" 
                            string="Completar" 
                            type="object" 
                            invisible="state != 'in_progress'"
                            class="btn-success"/>
                    <button name="action_cancel" 
                            string="Cancelar" 
                            type="object" 
                            invisible="state in ('completed', 'cancelled', 'no_show')"
                            class="btn-danger"
                            confirm="¿Está seguro de cancelar este turno?"/>
                    <button name="action_mark_no_show" 
                            string="No Asistió" 
                            type="object" 
                            invisible="state not in ('scheduled', 'confirmed')"
                            class="btn-warning"
                            confirm="¿Confirma que el paciente no asistió?"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,confirmed,in_progress,completed"/>
                </header>
                
                <sheet>
                    <widget name="web_ribbon" title="Completado" bg_color="text-bg-success"
                            invisible="state != 'completed'"/>
                    <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="No Asistió" bg_color="text-bg-danger"
                            invisible="state != 'no_show'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Información del Turno">
                            <field name="slot_id" readonly="1"/>
                            <field name="doctor_id" readonly="1"/>
                            <field name="specialty_id" readonly="1"/>
                            <field name="doctor_specialty_line_id" invisible="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                        <group string="Fecha y Hora">
                            <field name="appointment_date" readonly="1"/>
                            <field name="appointment_time" widget="float_time" readonly="1"/>
                            <field name="appointment_time_display" readonly="1"/>
                            <field name="appointment_datetime" invisible="1"/>
                            <field name="appointment_end_datetime" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Paciente">
                            <field name="patient_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="patient_id" 
                                   invisible="patient_type != 'human'"
                                   required="patient_type == 'human'"
                                   options="{'create_edit': True}"/>
                            <field name="pet_id" 
                                   invisible="patient_type != 'pet'"
                                   required="patient_type == 'pet'"
                                   options="{'create_edit': True}"/>
                            <field name="patient_display" readonly="1"/>
                        </group>
                        <group string="Pago">
                            <field name="payment_state"/>
                        </group>
                    </group>

                    <group string="Notas">
                        <field name="notes" nolabel="1" placeholder="Agregue notas sobre el turno..."/>
                    </group>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Search de Turnos -->
    <record id="view_medical_appointment_search" model="ir.ui.view">
        <field name="name">medical.appointment.search</field>
        <field name="model">medical.appointment</field>
        <field name="arch" type="xml">
            <search string="Buscar Turnos">
                <field name="name"/>
                <field name="patient_display"/>
                <field name="doctor_id"/>
                <field name="specialty_id"/>
                <field name="appointment_date"/>
                
                <filter name="scheduled" string="Agendados" domain="[('state', '=', 'scheduled')]"/>
                <filter name="confirmed" string="Confirmados" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_progress" string="En Curso" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completados" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelados" domain="[('state', '=', 'cancelled')]"/>
                <filter name="no_show" string="No Asistió" domain="[('state', '=', 'no_show')]"/>
                
                <separator/>
                <filter name="today" string="Hoy" domain="[('appointment_date', '=', context_today())]"/>
                <filter name="this_week" string="Esta Semana" 
                        domain="[('appointment_date', '&gt;=', (context_today() + relativedelta(weeks=-1, weekday=0)).strftime('%%Y-%%m-%%d')),
                                 ('appointment_date', '&lt;=', (context_today() + relativedelta(weeks=-1, weekday=6)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="next_week" string="Próxima Semana"
                        domain="[('appointment_date', '&gt;=', (context_today() + relativedelta(weeks=0, weekday=0)).strftime('%%Y-%%m-%%d')),
                                 ('appointment_date', '&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%%Y-%%m-%%d'))]"/>
                
                <separator/>
                <filter name="payment_pending" string="Pago Pendiente" domain="[('payment_state', '=', 'pending')]"/>
                <filter name="payment_paid" string="Pagado" domain="[('payment_state', '=', 'paid')]"/>
                
                <group expand="0" string="Agrupar Por">
                    <filter name="group_by_doctor" string="Médico" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_by_specialty" string="Especialidad" context="{'group_by': 'specialty_id'}"/>
                    <filter name="group_by_date" string="Fecha" context="{'group_by': 'appointment_date'}"/>
                    <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_by_payment" string="Estado de Pago" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para Turnos -->
    <record id="action_medical_appointment" model="ir.actions.act_window">
        <field name="name">Turnos Médicos</field>
        <field name="res_model">medical.appointment</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="context">{
            'search_default_today': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo turno
            </p>
            <p>
                Los turnos se gestionan a través de slots de horarios.
                Use el botón "Solicitar Turno" para crear un turno nuevo siguiendo el asistente.
            </p>
        </field>
    </record>

</odoo>
