        <!-- Animales de ejemplo -->
        <record id="animal_firulais" model="medical.patient.animal">
            <field name="name">Firulais</field>
            <field name="owner_id" ref="patient_garcia"/>
            <field name="species">dog</field>
            <field name="breed">Golden Retriever</field>
            <field name="gender">male</field>
            <field name="birth_date" eval="(datetime.now() - timedelta(days=365*3)).strftime('%Y-%m-%d')"/>
            <field name="weight">28.5</field>
            <field name="castrated" eval="True"/>
        </record>

        <record id="animal_michi" model="medical.patient.animal">
            <field name="name">Michi</field>
