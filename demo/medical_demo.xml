<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Contactos de Médicos -->
        <record id="partner_doctor_martinez" model="res.partner">
            <field name="name">Dr. Juan Martínez</field>
            <field name="phone">+54 11 4567-8901</field>
            <field name="email">jmartinez@clinica.com</field>
            <field name="is_company" eval="False"/>
        </record>

        <record id="partner_doctor_gomez" model="res.partner">
            <field name="name">Dra. María Gómez</field>
            <field name="phone">+54 11 4567-8902</field>
            <field name="email">mgomez@clinica.com</field>
            <field name="is_company" eval="False"/>
        </record>

        <record id="partner_doctor_fernandez" model="res.partner">
            <field name="name">Dr. Carlos Fernández</field>
            <field name="phone">+54 11 4567-8903</field>
            <field name="email">cfernandez@veterinaria.com</field>
            <field name="is_company" eval="False"/>
        </record>

        <!-- Médicos -->
        <record id="doctor_martinez" model="medical.doctor">
            <field name="name">Dr. Juan Martínez</field>
            <field name="partner_id" ref="partner_doctor_martinez"/>
            <field name="license_number">MN12345</field>
            <field name="specialty_ids" eval="[(6, 0, [ref('specialty_general_medicine'), ref('specialty_cardiology')])]"/>
            <field name="color">1</field>
        </record>

        <record id="doctor_gomez" model="medical.doctor">
            <field name="name">Dra. María Gómez</field>
            <field name="partner_id" ref="partner_doctor_gomez"/>
            <field name="license_number">MN54321</field>
            <field name="specialty_ids" eval="[(6, 0, [ref('specialty_pediatrics'), ref('specialty_dermatology')])]"/>
            <field name="color">3</field>
        </record>

        <record id="doctor_fernandez" model="medical.doctor">
            <field name="name">Dr. Carlos Fernández</field>
            <field name="partner_id" ref="partner_doctor_fernandez"/>
            <field name="license_number">MV98765</field>
            <field name="specialty_ids" eval="[(6, 0, [ref('specialty_vet_general'), ref('specialty_vet_surgery')])]"/>
            <field name="color">9</field>
        </record>

        <!-- Agendas -->
        <record id="schedule_martinez" model="medical.schedule">
            <field name="name">Agenda - Dr. Martínez</field>
            <field name="doctor_id" ref="doctor_martinez"/>
            <field name="active" eval="True"/>
        </record>

        <record id="schedule_gomez" model="medical.schedule">
            <field name="name">Agenda - Dra. Gómez</field>
            <field name="doctor_id" ref="doctor_gomez"/>
            <field name="active" eval="True"/>
        </record>

        <record id="schedule_fernandez" model="medical.schedule">
            <field name="name">Agenda - Dr. Fernández</field>
            <field name="doctor_id" ref="doctor_fernandez"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Horarios para Dr. Martínez (Lunes a Viernes 8:00-12:00) -->
        <record id="schedule_line_martinez_mon_am" model="medical.schedule.line">
            <field name="schedule_id" ref="schedule_martinez"/>
            <field name="day_of_week">0</field>
            <field name="hour_from">8.0</field>
            <field name="hour_to">12.0</field>
        </record>

        <record id="schedule_line_martinez_mon_pm" model="medical.schedule.line">
            <field name="schedule_id" ref="schedule_martinez"/>
            <field name="day_of_week">0</field>
            <field name="hour_from">14.0</field>
            <field name="hour_to">18.0</field>
        </record>

        <record id="schedule_line_martinez_tue" model="medical.schedule.line">
            <field name="schedule_id" ref="schedule_martinez"/>
